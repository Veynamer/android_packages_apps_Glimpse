<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Images -->
    <com.github.panpf.zoomimage.GlideZoomImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:disabledScrollBar="true" />

    <!-- Video -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:bar_height="4dp"
        app:buffered_color="?attr/colorSurfaceVariant"
        app:played_color="?attr/colorPrimary"
        app:scrubber_color="?attr/colorPrimary"
        app:scrubber_dragged_size="20dp"
        app:scrubber_enabled_size="14dp"
        app:show_next_button="false"
        app:show_previous_button="false"
        app:show_shuffle_button="false"
        app:show_subtitle_button="true"
        app:show_timeout="0"
        app:touch_target_height="32dp"
        app:unplayed_color="#4DFFFFFF" />

</FrameLayout>
