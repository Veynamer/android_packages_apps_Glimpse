<resources>
    <!--
         Material You / Expressive shape scale.

         Rounder than the stock Material 3 defaults (4/8/12/16/28dp) across
         the board - this drives the corners of popup menus, dialogs, bottom
         sheets, cards, chips and buttons app-wide via the theme's
         shapeAppearance*Component attributes, so individual widgets don't
         need to be re-styled one by one.
    -->
    <style name="ShapeAppearance.Glimpse.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Glimpse.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Glimpse.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Glimpse.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Glimpse.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">36dp</item>
    </style>

    <!-- Fully rounded pill shape, used for buttons -->
    <style name="ShapeAppearance.Glimpse.Full" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
