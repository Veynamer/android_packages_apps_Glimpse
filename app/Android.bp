package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "Glimpse",

    srcs: ["src/main/java/**/*.kt"],
    resource_dirs: ["src/main/res"],
    manifest: "src/main/AndroidManifest.xml",

    sdk_version: "37",
    product_specific: true,

    aaptflags: [
        // DO NOT EDIT THIS SECTION MANUALLY
        "--version-name",
        "1.1",
        "--version-code",
        "1",
    ],

    use_embedded_native_libs: true,

    overrides: [
        "Gallery",
        "Gallery3D",
        "GalleryNew3D",
    ],

    required: [
        "GlimpseFrameworksBaseOverlay",
        "initial-package-stopped-states-org.lineageos.glimpse",
        "preinstalled-packages-org.lineageos.glimpse",
    ],

    static_libs: [
        // DO NOT EDIT THIS SECTION MANUALLY
        "androidx.activity_activity",
        "androidx.activity_activity-compose",
        "androidx.appcompat_appcompat",
        "androidx.compose_compose-bom",
        "androidx.compose.animation_animation",
        "androidx.compose.animation_animation-core",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.material_material-ripple",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.compose.runtime_runtime-annotation",
        "androidx.compose.runtime_runtime-retain",
        "androidx.compose.runtime_runtime-saveable",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-geometry",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.ui_ui-text",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.compose.ui_ui-unit",
        "androidx.compose.ui_ui-util",
        "androidx-constraintlayout_constraintlayout",
        "androidx.core_core-ktx",
        "androidx.exifinterface_exifinterface",
        "androidx.fragment_fragment-ktx",
        "androidx.graphics_graphics-shapes",
        "androidx.lifecycle_lifecycle-runtime",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-service",
        "androidx.lifecycle_lifecycle-viewmodel-savedstate",
        "Glimpse_androidx.media3_media3-common-ktx",
        "Glimpse_androidx.media3_media3-exoplayer",
        "Glimpse_androidx.media3_media3-exoplayer-dash",
        "Glimpse_androidx.media3_media3-exoplayer-hls",
        "Glimpse_androidx.media3_media3-exoplayer-rtsp",
        "Glimpse_androidx.media3_media3-exoplayer-smoothstreaming",
        "Glimpse_androidx.media3_media3-ui",
        "androidx.navigation_navigation-common",
        "androidx.navigation_navigation-fragment-ktx",
        "androidx.navigation_navigation-runtime",
        "androidx.navigation_navigation-ui-ktx",
        "androidx.navigationevent_navigationevent",
        "androidx.navigationevent_navigationevent-compose",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "androidx.recyclerview_recyclerview-selection",
        "androidx.savedstate_savedstate",
        "androidx.savedstate_savedstate-compose",
        "androidx.viewpager2_viewpager2",
        "androidx.window_window-core",
        "Glimpse_com.adobe.xmp_xmpcore",
        "Glimpse_com.github.bumptech.glide_compose",
        "Glimpse_com.github.bumptech.glide_glide",
        "Glimpse_com.github.bumptech.glide_okhttp3-integration",
        "Glimpse_com.google.android.material_material",
        "Glimpse_com.squareup.okhttp3_okhttp",
        "Glimpse_com.squareup.okhttp3_okhttp-android",
        "Glimpse_io.github.awxkee_jxl-coder",
        "Glimpse_io.github.awxkee_jxl-coder-glide",
        "Glimpse_io.github.panpf.zoomimage_zoomimage-core-android",
        "Glimpse_io.github.panpf.zoomimage_zoomimage-view-glide",
        "kotlin-stdlib",
    ],

    optimize: {
        optimize: true,
        proguard_flags_files: ["proguard-rules.pro"],
        shrink_resources: true,
    },
}

prebuilt_etc {
    name: "initial-package-stopped-states-org.lineageos.glimpse",
    product_specific: true,
    sub_dir: "sysconfig",
    src: "initial-package-stopped-states-org.lineageos.glimpse.xml",
    filename_from_src: true,
}

prebuilt_etc {
    name: "preinstalled-packages-org.lineageos.glimpse",
    product_specific: true,
    sub_dir: "sysconfig",
    src: "preinstalled-packages-org.lineageos.glimpse.xml",
    filename_from_src: true,
}
